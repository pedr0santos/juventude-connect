NODE_ENV=development
DATABASE_URL=mysql://user:password@localhost:3306/juventude_connect
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# First administrator bootstrap. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-of-at-least-8-characters

# Required for password recovery emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Juventude Connect <no-reply@example.com>
